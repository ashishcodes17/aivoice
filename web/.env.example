NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

VOICELINK_API_TOKEN=
# Random string appended to the VoiceLink webhook URL path (webhooks are not signed)
VOICELINK_WEBHOOK_SECRET=

# Price charged to the wallet per call minute, in paise
CALL_RATE_PAISE_PER_MIN=300

# Lets the dashboard ask VoiceLink to place outbound calls ("Get a call from your agent").
# Get it by logging in to VoiceLink's API: POST /api/v1/auth/login -> data.access_token
VOICELINK_API_TOKEN=

# Set to "true" to refuse callbacks (and, later, other calls) when the wallet cannot cover a minute.
ENFORCE_WALLET_CHECK=false

# Public URL of the voice worker (shown as the WhatsApp webhook address on the WhatsApp page)
NEXT_PUBLIC_WORKER_URL=

# ---- Test number and rented numbers -------------------------------------------------------------
# Shared test line: every account can have its agent ring their phone from it. Digits only.
TEST_DID_NUMBER=919429490400
# Most test calls the whole platform allows in 24 hours.
TEST_CALLS_PLATFORM_PER_DAY=300

# Renting numbers spends real money on VoiceLink. Leave "false" until tested with one number.
NUMBER_PURCHASE_ENABLED=false
# VoiceLink WebSocket bot IDs that rented numbers are pointed at (outbound defaults to the inbound one).
VOICELINK_INBOUND_BOT_ID=
VOICELINK_OUTBOUND_BOT_ID=
# Refuse to buy a number that costs us more than this many rupees a month on VoiceLink.
NUMBER_MAX_PROVIDER_COST=300
# Secret for the daily renewals job: GET /api/cron/number-renewals with "Authorization: Bearer <secret>".
CRON_SECRET=
# "true" lets the renewals job actually give back a number that was cancelled or is unpaid. Irreversible.
NUMBER_RELEASE_ON_LAPSE=false
