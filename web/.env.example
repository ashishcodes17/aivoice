NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

VOICELINK_API_TOKEN=
# Random string appended to the VoiceLink webhook URL path (webhooks are not signed)
VOICELINK_WEBHOOK_SECRET=

# Price charged to the wallet per call minute, in paise
CALL_RATE_PAISE_PER_MIN=300

# Lets the dashboard ask VoiceLink to place outbound calls ("Get a call from your agent").
# Get it by logging in to VoiceLink's API: POST /api/v1/auth/login -> data.access_token
VOICELINK_API_TOKEN=

# Set to "true" to refuse callbacks (and, later, other calls) when the wallet cannot cover a minute.
ENFORCE_WALLET_CHECK=false
